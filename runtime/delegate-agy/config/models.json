      "wait_sec": 1200,
      "use": "작업 분할 · 하위 계획까지 맡기는 여러 파일 새 기능 · 중대형 리팩터링 (Neon 계획/검토 + Hydrogen 실행)"
    },
    "feature-carbon": {
      "model": "gemini-pro-orchestrator",
